{
  "name": "obsidian-reel",
  "version": "0.7.81",
  "description": "Track films and series in your Obsidian vault with TMDB metadata. Mobile-first.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "npm run test:logic && npm run test:crypto && npm run test:content && npm run test:mutations && npm run test:legacy && npm run test:prune && npm run test:importer && npm run test:library && npm run test:notes && npm run test:posters && npm run test:undo && npm run test:swatch && npm run test:failure && npm run test:suggest && npm run test:milestones && npm run test:blend && npm run test:cachekey && npm run test:roving && npm run test:settingsguard && npm run test:gesture && npm run test:snapshot",
    "test:content": "esbuild tests/content.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.content.cjs --log-level=error && node tests/.content.cjs",
    "test:logic": "esbuild tests/selftest.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.selftest.cjs --log-level=error && node tests/.selftest.cjs",
    "test:crypto": "esbuild tests/crypto.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.crypto.cjs --log-level=error && node tests/.crypto.cjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "preflight": "node scripts/preflight.mjs",
    "release": "node scripts/publish.mjs",
    "doctor": "node scripts/doctor.mjs",
    "publish": "node scripts/publish.mjs",
    "setup": "git config core.hooksPath .githooks && node scripts/doctor.mjs",
    "connect": "node scripts/connect.mjs",
    "install-local": "npm run build && node scripts/install.mjs",
    "push-to-vault": "node scripts/install.mjs",
    "test:mutations": "esbuild tests/mutations.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.mutations.cjs --log-level=error && node tests/.mutations.cjs",
    "test:legacy": "esbuild tests/legacy.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.legacy.cjs --log-level=error && node tests/.legacy.cjs",
    "test:prune": "esbuild tests/prune.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.prune.cjs --log-level=error && node tests/.prune.cjs",
    "test:importer": "esbuild tests/importer.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.importer.cjs --log-level=error && node tests/.importer.cjs",
    "test:library": "esbuild tests/library.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.library.cjs --log-level=error && node tests/.library.cjs",
    "test:notes": "esbuild tests/notes.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.notes.cjs --log-level=error && node tests/.notes.cjs",
    "test:posters": "esbuild tests/posters.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.posters.cjs --log-level=error && node tests/.posters.cjs",
    "test:undo": "esbuild tests/undo.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.undo.cjs --log-level=error && node tests/.undo.cjs",
    "test:swatch": "esbuild tests/swatch.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.swatch.cjs --log-level=error && node tests/.swatch.cjs",
    "test:failure": "esbuild tests/failure.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.failure.cjs --log-level=error && node tests/.failure.cjs",
    "test:suggest": "esbuild tests/suggest.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.suggest.cjs --log-level=error && node tests/.suggest.cjs",
    "test:milestones": "esbuild tests/milestones.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.milestones.cjs --log-level=error && node tests/.milestones.cjs",
    "test:blend": "esbuild tests/blend.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.blend.cjs --log-level=error && node tests/.blend.cjs",
    "test:cachekey": "esbuild tests/cachekey.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.cachekey.cjs --log-level=error && node tests/.cachekey.cjs",
    "test:roving": "esbuild tests/roving.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.roving.cjs --log-level=error && node tests/.roving.cjs",
    "harness": "esbuild harness/main.ts --bundle --format=iife --alias:obsidian=./harness/shim.ts --outfile=harness/bundle.js --log-level=warning",
    "audit": "npm run harness && node scripts/audit.mjs",
    "check": "npm run preflight && npm test && npm run audit",
    "test:settingsguard": "esbuild tests/settingsguard.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.settingsguard.cjs --log-level=error && node tests/.settingsguard.cjs",
    "test:gesture": "esbuild tests/gesture.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.gesture.cjs --log-level=error && node tests/.gesture.cjs",
    "test:snapshot": "esbuild tests/snapshot.test.ts --bundle --platform=node --format=cjs --alias:obsidian=./tests/obsidian-stub.ts --outfile=tests/.snapshot.cjs --log-level=error && node tests/.snapshot.cjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tmdb",
    "films",
    "letterboxd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "esbuild": "0.20.2",
    "obsidian": "latest",
    "puppeteer-core": "^25.7.0",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}
