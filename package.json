{
  "name": "obsidian-reel",
  "version": "0.1.0",
  "description": "Track films and series in your Obsidian vault with TMDB metadata. Mobile-first.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild tests/selftest.ts --bundle --platform=node --format=cjs --outfile=tests/.selftest.cjs --log-level=error && node tests/.selftest.cjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "tmdb",
    "films",
    "letterboxd"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "3.3.0",
    "esbuild": "0.20.2",
    "obsidian": "latest",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}
