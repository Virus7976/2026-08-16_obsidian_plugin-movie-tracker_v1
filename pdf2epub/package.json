{
  "name": "pdf-to-epub",
  "version": "1.1.0",
  "description": "Turn a PDF into a properly typeset EPUB \u2014 chapters, figures and a real title page \u2014 entirely in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node test/run.mjs test/fixtures/sample-book.pdf && node test/run.mjs test/fixtures/hard-sample.pdf && node test/library.mjs",
    "sample": "python3 tools/make_sample.py test/fixtures/sample-book.pdf && python3 tools/make_hard_sample.py test/fixtures/hard-sample.pdf",
    "assets": "node tools/copy-pdfjs-assets.mjs",
    "predev": "node tools/copy-pdfjs-assets.mjs",
    "prebuild": "node tools/copy-pdfjs-assets.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "keywords": [
    "pdf",
    "epub",
    "converter",
    "ebook",
    "pwa",
    "offline",
    "pdfjs",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Virus7976/pdf-to-epub.git"
  }
}